{
  "schema_version": "1.0",
  "source_manifest": "config/source_manifest.jsonl",
  "regional_mapping": "config/un_regional_groups.csv",
  "output_directory": "output/pipeline",
  "taxonomy_file": "config/theme_taxonomy.json",
  "additional_paid_api_allowed": false,
  "scope": {
    "years": [
      2017,
      2018,
      2019,
      2020,
      2021,
      2022,
      2023,
      2024,
      2025,
      2026
    ],
    "awaiting_user_sources": [],
    "partial_years": [],
    "coverage_file": "output/corpus_preparation/country_year_coverage.csv",
    "unit": "one Member State main General Debate address per country-year",
    "position_attribution": "The main address delivered on behalf of a Member State represents that country's position for the given year",
    "analyze_speaker_rank": false,
    "include_external_provisional_sources": false
  },
  "sources": {
    "policy": "English verbatim primary; 2025 and 2026 automatic transcripts accepted by user as canonical originals",
    "accepted_automatic_transcript_years": [
      2025,
      2026
    ],
    "acceptance_basis": "user instruction: supplied transcripts are the original corpus; PDF counterparts are not required",
    "preserve_automatic_transcription_quality_flags": true,
    "minimum_expected_speeches": {
      "2017": 193,
      "2018": 193,
      "2019": 192,
      "2020": 190,
      "2021": 191,
      "2022": 190,
      "2023": 189,
      "2024": 190,
      "2025": 189,
      "2026": 191
    }
  },
  "preprocessing": {
    "passage_max_words": 350,
    "passage_max_chars": 3000,
    "passage_rule": "bounded contiguous spans of extracted source paragraphs; no overlap or rewriting"
  },
  "discovery": {
    "provider": "openai",
    "model": "text-embedding-3-large",
    "dimensions": 3072,
    "api_key_env": "OPENAI_API_KEY",
    "execution_status": "implemented; awaiting explicit analysis execution",
    "embedding_scope": "context-verified AI passages plus necessary adjacent context; not full speeches",
    "distance": "cosine",
    "linkage": "average",
    "use_existing_embeddings": true,
    "cache_compatibility": "same provider/model/dimensions/text/preprocessing only; never reuse MiniLM vectors as OpenAI vectors",
    "unit": "semantic passage",
    "purpose": "taxonomy discovery only; never final statistical labels",
    "passage_scope": "all context-verified AI passages across included years; no one-per-country-year sampling",
    "mean_center_before_cosine": true,
    "candidate_k": [
      6,
      8,
      10,
      12,
      16
    ],
    "max_cluster_share": 0.4,
    "dominant_cluster_action": "re-cluster dominant cluster with same metric/linkage; record split",
    "representatives_per_cluster": 5,
    "boundary_passages_per_cluster": 3,
    "diagnostics_file": "discovery_diagnostics.json",
    "taxonomy_payload_max_chars": 120000
  },
  "classification": {
    "batch_passages": 8,
    "batch_max_chars": 28000,
    "values": [
      "Yes",
      "No",
      "Uncertain",
      "Pending"
    ],
    "require_source_review": true,
    "reuse_existing_reviewed_decisions": true,
    "unit": "passage",
    "passage_labels_file": "paragraph_theme_labels.csv",
    "country_year_notes_fill_passage_labels": false
  },
  "themes": {
    "min_N_for_yearly_percentages": 20,
    "below_threshold": "report counts and cases, not percentages"
  },
  "review": {
    "scope": "screened_speeches",
    "primary_passes": 1,
    "negative_sample_per_stratum": 2,
    "sample_seed": "unga-review-v1",
    "second_review_percent": 10,
    "expand_on_audit_hit": true
  },
  "institutions": {
    "stances_file": "institution_stances.csv",
    "mechanisms": [
      "Dialogue",
      "Panel",
      "Fund",
      "FSB-like",
      "IAEA-like",
      "IPCC-like",
      "CERN-like",
      "New body/verification regime",
      "Other model"
    ],
    "stances": [
      "mention",
      "welcome",
      "support",
      "request",
      "concern",
      "opposition",
      "commitment"
    ],
    "functions": [
      "dialogue/convening",
      "scientific assessment",
      "capacity building",
      "financing",
      "norms/rules/standards",
      "monitoring/oversight/verification",
      "coordination",
      "other"
    ],
    "un_role": [
      "explicit",
      "generic"
    ]
  },
  "aggregation": {
    "regional_system": "UN regional groups",
    "mapping_as_of": "2026-09-25",
    "mapping_timezone": "America/New_York",
    "fixed_mapping_across_years": true,
    "unaffiliated_policy": "separate",
    "country_theme_rule": "OR of reviewed Yes; No only after complete review; otherwise NA"
  },
  "report": {
    "render_with_word": true,
    "basename": "UNGA81_AI_Strategic_Review",
    "language": "en",
    "minimum_pages": 4,
    "maximum_pages": 6,
    "sections": [
      "Key Facts and Figures",
      "Themes",
      "Role of UN",
      "Implications"
    ]
  },
  "execution": {
    "text_backend": "codex_subscription",
    "api_scope": "embeddings_only",
    "subscription_model_preference": "gpt-6-astra",
    "subscription_reasoning_preference": "high",
    "subscription_pending_limit": 16,
    "review_model": "gpt-5.4-mini",
    "reasoning_effort": "low",
    "max_output_tokens": 6000,
    "request_timeout_seconds": 120,
    "default_cost_limit_usd": 1.0,
    "require_execute_flag": true,
    "review_batch_passages": 40,
    "workers": 4,
    "max_discovery_passages": 5000,
    "embedding_batch_size": 32,
    "output_directory": "output/analysis",
    "pricing_checked": "2026-09-28",
    "review_input_usd_per_million": 0.75,
    "review_output_usd_per_million": 4.5,
    "embedding_usd_per_million": 0.13,
    "pricing_sources": [
      "https://developers.openai.com/api/docs/models/gpt-5.4-mini",
      "https://developers.openai.com/api/docs/models/text-embedding-3-large"
    ]
  },
  "cost_estimation": {
    "chars_per_token": 4.0,
    "output_tokens_per_request": [
      900,
      2000,
      3000
    ],
    "assumed_theme_codes": 12,
    "assumed_taxonomy_chars": 12000,
    "classification_instruction_chars": 2200,
    "other_instruction_schema_chars": 3500,
    "protocol_overhead_tokens_per_request": 128,
    "assumed_report_input_chars": 120000,
    "assumed_web_reference_chunks": 3
  }
}
